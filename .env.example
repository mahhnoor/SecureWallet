# OPTIONAL. docker-compose.yml already has working defaults for everything here.
# Copy this file to ".env" (same folder as docker-compose.yml) only if you want
# to change a value. Never commit the real .env file.

DB_PASSWORD=wallet_dev_password

# Must be 32+ characters or the API refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef-not-for-production

# Where the web app is opened in the browser (comma-separated allow-list).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where the browser reaches the API. Changing this needs: docker compose up --build
VITE_API_URL=http://localhost:4000/api

# true = create demo users ali and sara on start-up
SEED_DEMO_DATA=true
