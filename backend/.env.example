# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet_app
DB_PASSWORD=change_me
DB_NAME=fintech_wallet

# SEC: generate a long random secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
